# Private key material and runtime state for the local CA / broker
# credential layer. Never commit any of this -- see project-holden-scope.md
# Credential/RBAC Architecture. Config *shape* (ca.json, vault config.hcl)
# is fine to track; keys, unseal material, and tokens are not.
broker/infra/step-ca/secrets/
broker/infra/step-ca/db/
broker/infra/vault/data/
broker/infra/vault/tls/
*.key
*_key
*token*
*unseal*
*.pem

# personal, not team-shared
.claude/settings.local.json
CLAUDE.md

# containerlab-generated per-run lab state (SSH configs, TLS material,
# inventories) -- regenerated on every deploy, not source
testing/topologies/clab-*/

# Python bytecode cache
__pycache__/
*.pyc

# Parser/Tool layer runtime logs -- generated per-run, not source
parser/logs/

# RAG vector store -- build artifact, regenerate with rag/build_index.py
rag/vector_store/
